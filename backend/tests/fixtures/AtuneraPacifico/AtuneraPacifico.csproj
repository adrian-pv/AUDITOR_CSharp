<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Proyecto de PRUEBA para AUDITOR_C#: trae paquetes vulnerables a propósito
         para que las reglas los detecten. Se desactiva la auditoría de NuGet para
         que el editor no lo marque como un problema real. No se compila ni se ejecuta. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
  </ItemGroup>
</Project>
